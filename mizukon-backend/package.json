{
	"name": "mizukon-backend",
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "npm run build && concurrently -k -p \"[{name}]\" -n \"TypeScript,App\" -c \"yellow.bold,cyan.bold\" \"npm:watch:ts\" \"npm:watch:node\"",
		"watch:ts": "tsc -p tsconfig.json --watch",
		"watch:node": "node --watch build/index.js",
		"build": "prisma generate && tsc -p tsconfig.json",
		"start": "node build/index.js",
		"migrate": "prisma migrate dev && prisma generate"
	},
	"dependencies": {
		"@better-auth/prisma-adapter": "1.6.26",
		"@fastify/autoload": "^6.3.1",
		"@fastify/cors": "^11.3.0",
		"@fastify/one-line-logger": "^2.1.0",
		"@fastify/sensible": "^6.0.4",
		"@fastify/type-provider-typebox": "^6.1.0",
		"@prisma/adapter-libsql": "^7.8.0",
		"@prisma/client": "^7.8.0",
		"better-auth": "1.6.26",
		"dotenv": "^17.4.2",
		"fastify": "^5.10.0",
		"fastify-plugin": "^6.0.0"
	},
	"devDependencies": {
		"@types/node": "^25.9.3",
		"concurrently": "^10.0.3",
		"pino-pretty": "^13.1.3",
		"prisma": "^7.8.0",
		"typescript": "^6.0.3"
	},
	"author": "MD Jashim Mallick",
	"license": "MIT"
}
